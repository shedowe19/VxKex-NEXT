LIBRARY KxAdvapi
EXPORTS
	;; service.c - preserve native SCM results while preparing local service images
	OpenSCManagerA = Ext_OpenSCManagerA
	OpenSCManagerW = Ext_OpenSCManagerW
	OpenServiceA = Ext_OpenServiceA
	OpenServiceW = Ext_OpenServiceW
	CreateServiceA = Ext_CreateServiceA
	CreateServiceW = Ext_CreateServiceW
	CloseServiceHandle = Ext_CloseServiceHandle
	StartServiceA = Ext_StartServiceA
	StartServiceW = Ext_StartServiceW
	;; Forwarders to KexDll
	EventSetInformation			= KexDll.KexEtwEventSetInformation

	;; Forwarders to KxBase
	CreateWellKnownSid			= KxBase.CreateWellKnownSid

	;; time.c
	EnumDynamicTimeZoneInformation
	GetDynamicTimeZoneInformationEffectiveYears

	;; token.c
	OpenProcessToken			= Ext_OpenProcessToken

	;; reggval.c
	RegGetValueA				= Ext_RegGetValueA
	RegGetValueW				= Ext_RegGetValueW

	;; regqval.c
	RegQueryValueExW			= Ext_RegQueryValueExW
